# syntax=docker/dockerfile:1.7

# ---- build stage ----
FROM node:22-alpine AS build
WORKDIR /repo

# Install pnpm directly rather than going through corepack. Recent node:22-alpine
# images ship without the corepack shim on PATH (RUN corepack enable -> exit 127),
# and corepack is still flagged as experimental upstream — pinning via npm is
# more reliable and produces the same lockfile-compatible pnpm binary.
RUN npm install -g pnpm@11.1.3

# Restore lockfile first for cache friendliness.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY web/package.json web/
RUN pnpm install --frozen-lockfile

COPY shared shared
COPY web web

RUN pnpm --filter dwbhub-web build

# ---- runtime stage ----
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY --from=build /repo/web/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=4 \
    CMD wget --quiet --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
