# syntax=docker/dockerfile:1.7

# ---- build stage ----
# Debian-slim base instead of Alpine: in our environment node:22-alpine resolved
# to an image where neither `corepack` nor `npm` were on PATH (both exited 127),
# pointing at a stale/partial image manifest in the local docker cache. The
# bookworm-slim variant ships node + npm on /usr/local/bin reliably and is the
# more conservative choice for a build stage. Runtime stage stays Alpine.
FROM node:22-bookworm-slim AS build
WORKDIR /repo

RUN npm install -g pnpm@11.1.3

# Restore lockfile first for cache friendliness.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY web/package.json web/
RUN pnpm install --frozen-lockfile

COPY shared shared
COPY web web

RUN pnpm --filter dwbhub-web build

# ---- runtime stage ----
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

COPY --from=build /repo/web/dist /usr/share/nginx/html
COPY deploy/docker/nginx.conf /etc/nginx/nginx.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=4 \
    CMD wget --quiet --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
