# Plan 0.8.1 — e2e test runner.
# Base: Microsoft's official Playwright image. It ships Node 22 + Chromium + Firefox + WebKit
# + all OS-level deps, pinned to the Playwright minor version.
#
# IMPORTANT: bump the tag below whenever you bump @playwright/test in web/package.json.
# The minor versions MUST match (e.g. v1.49.x image + ^1.49.x in package.json).
FROM mcr.microsoft.com/playwright:v1.49.1-noble

# The Playwright v1.49.1-noble base ships Node 22.12.0; pnpm 11.x requires >=22.13.
# Refresh the NodeSource 22.x repo to pull the latest 22.x patch before installing pnpm.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# Pin pnpm to the same version as Dockerfile.frontend (single source: root package.json packageManager).
RUN npm install -g pnpm@11.1.3

# --- Docker CE CLI + buildx + compose plugins (no daemon) ---
# Installed from Docker's official apt repo (NOT ubuntu's `docker.io` package).
# Why: docker.io is the legacy builder — no buildx, no compose v2 plugin, and
# `docker build --progress=plain` is rejected (so BuildKit's live step output
# is unavailable). The official Docker CE CLI bundles buildx + compose v2 as
# native plugins. jobs/e2e.sh talks to the HOST daemon via mounted
# /var/run/docker.sock — no docker daemon runs inside this image.
# (Previously e2e.sh had a runtime installer fallback; with this build-time
# install that fallback is now unreachable but kept for portability.)
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce-cli docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/test-runners/entrypoint.sh /opt/test-runners/entrypoint.sh
COPY deploy/test-runners/jobs/         /opt/test-runners/jobs/
RUN chmod +x /opt/test-runners/entrypoint.sh /opt/test-runners/jobs/*.sh 2>/dev/null || true

WORKDIR /workspace
ENTRYPOINT ["/opt/test-runners/entrypoint.sh"]
