# Plan 0.8.1 — backend / openapi / sql-lint / container-smoke / discord-live test runner.
# Base: official .NET 10 SDK on Debian (mcr.microsoft.com is fast + signed).
FROM mcr.microsoft.com/dotnet/sdk:10.0

# --- System packages ---
# curl + gpg: prerequisite for PowerShell + Docker apt repos.
# ca-certificates: for HTTPS to Discord + NuGet.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl gnupg ca-certificates apt-transport-https \
    && rm -rf /var/lib/apt/lists/*

# --- Docker CE CLI + buildx + compose plugins (no daemon) ---
# Installed from Docker's official apt repo (NOT debian's `docker.io` package).
# Why: docker.io is the legacy builder — no buildx plugin, no compose plugin,
# and `docker build` rejects `--progress=plain`, so BuildKit's live step-by-step
# output mode is unavailable. The official Docker CE CLI bundles buildx +
# compose v2 as native plugins, giving us:
#   * `docker build --progress=plain` -> live streaming of every RUN step
#   * `docker compose` (v2) without runtime installer hackery in jobs/e2e.sh
# All three jobs that exec `docker` (container-smoke, e2e, discord-live) talk to
# the host daemon via mounted /var/run/docker.sock — no docker daemon runs here.
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        docker-ce-cli docker-buildx-plugin docker-compose-plugin \
    && rm -rf /var/lib/apt/lists/*

# --- PowerShell 7 ---
# Microsoft's official Debian repo. Latest 7.x from the repo (Pester compatibility
# is what matters; Pester is pinned to 5.5.0 below).
RUN curl -sSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /usr/share/keyrings/microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
        > /etc/apt/sources.list.d/microsoft.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends powershell \
    && rm -rf /var/lib/apt/lists/*

# --- Pester (PowerShell module for SQL-lint tests in tools/tests/) ---
RUN pwsh -Command "Install-Module -Name Pester -RequiredVersion 5.5.0 -Force -SkipPublisherCheck -Scope AllUsers"

# --- Entrypoint + jobs (copied at build time so they're available without bind-mount) ---
COPY deploy/test-runners/entrypoint.sh /opt/test-runners/entrypoint.sh
COPY deploy/test-runners/jobs/         /opt/test-runners/jobs/
RUN chmod +x /opt/test-runners/entrypoint.sh /opt/test-runners/jobs/*.sh 2>/dev/null || true

WORKDIR /workspace
ENTRYPOINT ["/opt/test-runners/entrypoint.sh"]
