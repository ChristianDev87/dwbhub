# Copy to .env (or .env.dev) and adjust. Do NOT commit a real .env.

# --- Database ---
POSTGRES_DB=dwbhub
POSTGRES_USER=dwbhub
POSTGRES_PASSWORD=dwbhub_dev_pw
POSTGRES_PORT=5432
DWBHUB_DB_CONNECTION=Host=postgres;Port=5432;Database=dwbhub;Username=dwbhub;Password=dwbhub_dev_pw

# --- SMTP (MailHog in dev) ---
DWBHUB_SMTP_HOST=mailhog
DWBHUB_SMTP_PORT=1025
DWBHUB_SMTP_FROM=DwbHub <noreply@dwbhub.local>
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Setup wizard (Plan 0.3d) ---
# Path inside the API container where the bootstrap token is written on first
# start. Default works with the api-data volume below. Override only if you
# mount the volume somewhere else.
DWBHUB_BOOTSTRAP_TOKEN_FILE=/data/dwbhub/bootstrap-token.txt

# --- Application secrets (MUST be set; dev defaults below are non-secret samples) ---
# 32-byte base64 -- generate with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
DWBHUB_JWT_SECRET=ZGV2X2p3dF9zZWNyZXRfZG9fbm90X3VzZV9pbl9wcm9k
DWBHUB_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Public URLs ---
DWBHUB_PUBLIC_URL=http://localhost:5173
DWBHUB_ALLOWED_ORIGINS=http://localhost:5173

# --- Port mappings ---
API_PORT=5080
WEB_PORT=5173

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Development

# --- Optional: Discord live-test credentials (Plan 0.8) ---
# These are ONLY consumed by api/tests/DwbHub.Tests.Integration/Bot/
# DiscordNetBotConnectionLiveTests.cs — they are NOT used by the production
# compose stack. CI sets them from GitHub Secrets on push to develop/main;
# leave them BLANK locally unless you are actively running live tests.
#
# To run live tests locally:
#   1. Create a throw-away dev Discord application (https://discord.com/developers/applications)
#   2. Create a SEPARATE file `deploy/compose/discord.dev.env` (gitignored) with:
#         DISCORD_DEV_BOT_TOKEN=<your-dev-bot-token>
#         DISCORD_DEV_GUILD_ID=<your-dev-guild-snowflake>
#      The file MUST live in deploy/compose/ — both `.env.*` and the explicit
#      name `discord.dev.env` are listed in .gitignore so it never reaches git.
#      Do NOT put the token in this file (.env.example) — that would be committed.
#   3. Run: pwsh scripts/run-discord-live-tests.ps1
#      The wrapper sources discord.dev.env, runs only the live tests, redacts
#      any token leakage in stdout, and unsets the env vars in finally.
#
# DISCORD_DEV_BOT_TOKEN=
# DISCORD_DEV_GUILD_ID=
