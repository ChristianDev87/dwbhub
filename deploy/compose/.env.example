# Copy to .env (or .env.dev) and adjust. Do NOT commit a real .env.

# --- Database ---
POSTGRES_DB=dwbhub
POSTGRES_USER=dwbhub
POSTGRES_PASSWORD=dwbhub_dev_pw
POSTGRES_PORT=5432
DWBHUB_DB_CONNECTION=Host=postgres;Port=5432;Database=dwbhub;Username=dwbhub;Password=dwbhub_dev_pw

# --- SMTP (MailHog in dev) ---
DWBHUB_SMTP_HOST=mailhog
DWBHUB_SMTP_PORT=1025
DWBHUB_SMTP_FROM=DwbHub <noreply@dwbhub.local>
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# --- Setup wizard (Plan 0.3d) ---
# Path inside the API container where the bootstrap token is written on first
# start. Default works with the api-data volume below. Override only if you
# mount the volume somewhere else.
DWBHUB_BOOTSTRAP_TOKEN_FILE=/data/dwbhub/bootstrap-token.txt

# --- Application secrets (MUST be set; dev defaults below are non-secret samples) ---
# 32-byte base64 -- generate with: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
DWBHUB_JWT_SECRET=ZGV2X2p3dF9zZWNyZXRfZG9fbm90X3VzZV9pbl9wcm9k
DWBHUB_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# --- Public URLs ---
DWBHUB_PUBLIC_URL=http://localhost:5173
DWBHUB_ALLOWED_ORIGINS=http://localhost:5173

# --- Port mappings ---
API_PORT=5080
WEB_PORT=5173

# --- Environment ---
ASPNETCORE_ENVIRONMENT=Development
