# DwbHub .gitignore

# .NET
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
[Dd]ebug/
[Rr]elease/
x64/
x86/
*.dll
*.pdb
*.exe
TestResults/
coverage/
*.coverage
*.coveragexml
artifacts/

# JS/TS
node_modules/
dist/
build/
out/
.next/
.cache/
.vite/
.turbo/
storybook-static/
playwright-report/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Repo-root pnpm store written by docker-compose.test.yml's named-volume mount
# when pnpm_config_store_dir is not honored by an outside-container pnpm invocation
.pnpm-store/

# Per-user IDE/tool session settings (local only)
.claude/

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local env / secrets
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.Development.json
*.local.json
discord.dev.env

# Logs — keep the directory marker so test-runner tmpfs mounts have an existing
# mountpoint inside the :ro workspace bind, but exclude the per-start log files.
logs/*
!logs/.gitkeep

# Test result outputs (Plan 0.8.1 — local CI runner)
# We commit only the .gitkeep marker so the directory exists for first-time clones.
test-results/*
!test-results/.gitkeep

# Temp / scratch
*.tmp
*.bak
*.swp
asd.txt

# Internal planning artefacts (specs/plans live here for the maintainer; not part of the public repo)
docs/superpowers/

# GitHub-platform-specific config: workflows go in the repo for the self-hosted runner,
# but the PR template stays local until the maintainer finalises external contribution guidelines.
.github/pull_request_template.md

# User-facing project documentation kept local while still being drafted. The maintainer
# will publish a polished version when the project is ready for public consumption.
# Backup: C:\Users\Delta\dwbhub-docs-backup\
PROJECT_BRIEFING_V2.md
README.md
CONTRIBUTING.md
CHANGELOG.md
CODE_OF_CONDUCT.md

# --- Stale tsc shadow files (recurring issue across Plan 0.8.1, 0.8.3, 0.8.4) ---
# `tsc -b` or IDE-triggered compilation can emit .js next to .tsx/.ts sources.
# Vite + Playwright + Vitest module resolution prefers .js when both exist, so
# stale compiled output silently overrides edits to the source. Block at the
# .gitignore layer; prep-workspace.sh additionally fails CI if any sneak in.
web/src/**/*.js
web/src/**/*.d.ts
web/tests/**/*.js
web/tests/**/*.d.ts
# Whitelist legitimate exceptions:
!web/src/lib/api/generated/schema.d.ts
!web/src/vite-env.d.ts
!web/eslint.config.js
!web/postcss.config.js
!web/prettier.config.js
!web/vite.config.ts
!web/playwright.config.ts
!web/vitest.config.ts
